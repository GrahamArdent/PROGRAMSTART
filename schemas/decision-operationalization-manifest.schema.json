{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GrahamArdent/PROGRAMSTART/schemas/decision-operationalization-manifest.schema.json",
  "title": "Decision Operationalization Manifest",
  "description": "Owner-native, non-authoritative-to-owner consumers contract for reconstructing an accepted decision plan and projecting it into Matrix without granting execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version","record_type","owner","source_ref","source_version","decision_refs",
    "convergence_source","projection_role","protected_outcome","obligations","planned_steps",
    "impact_scope","associations","gates","falsifiers","exclusions","non_goals","constraints",
    "residuals","acceptance_conditions","terminal_condition","invalidation_conditions",
    "reconsideration_triggers","coverage","execution_authority"
  ],
  "properties": {
    "contract_version": {"type":"string","minLength":1},
    "record_type": {"const":"decision_operationalization_manifest"},
    "owner": {"type":"string","minLength":1},
    "source_ref": {"type":"string","minLength":1},
    "source_version": {"type":"string","minLength":1},
    "decision_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "convergence_source": {
      "type":"object","additionalProperties":false,
      "required":["packet_ref","packet_hash","coverage_status","evidence_refs"],
      "properties":{
        "packet_ref":{"type":"string","minLength":1},
        "packet_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "coverage_status":{"enum":["unknown","partial","challenged"]},
        "evidence_refs":{"type":"array","items":{"type":"string","minLength":1}}
      }
    },
    "projection_role":{"enum":["REFERENCE_PLAN","ACTIVE_OPERATIONALIZATION"]},
    "protected_outcome":{"type":"string","minLength":1},
    "obligations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/obligation"}},
    "planned_steps":{"type":"array","items":{"$ref":"#/$defs/step"}},
    "impact_scope":{"type":"array","items":{"$ref":"#/$defs/impact"}},
    "associations":{"type":"array","items":{"$ref":"#/$defs/association"}},
    "gates":{"type":"array","items":{"$ref":"#/$defs/gate"}},
    "falsifiers":{"type":"array","items":{"$ref":"#/$defs/falsifier"}},
    "exclusions":{"type":"array","items":{"type":"string","minLength":1}},
    "non_goals":{"type":"array","items":{"type":"string","minLength":1}},
    "constraints":{"type":"array","items":{"type":"string","minLength":1}},
    "residuals":{"type":"array","items":{"type":"string","minLength":1}},
    "acceptance_conditions":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "terminal_condition":{"type":"string","minLength":1},
    "invalidation_conditions":{"type":"array","items":{"type":"string","minLength":1}},
    "reconsideration_triggers":{"type":"array","items":{"type":"string","minLength":1}},
    "coverage":{
      "type":"object","additionalProperties":false,
      "required":["status","method","evidence_refs","residuals"],
      "properties":{
        "status":{"enum":["unknown","partial","challenged"]},
        "method":{"type":"string","minLength":1},
        "evidence_refs":{"type":"array","items":{"type":"string","minLength":1}},
        "residuals":{"type":"array","items":{"type":"string","minLength":1}}
      }
    },
    "execution_authority":{"const":false}
  },
  "$defs":{
    "obligation":{
      "type":"object","additionalProperties":false,
      "required":["id","outcome","owner_ref","acceptance_refs","terminal_refs","invalidation_triggers"],
      "properties":{
        "id":{"type":"string","minLength":1},"outcome":{"type":"string","minLength":1},
        "owner_ref":{"type":"string","minLength":1},
        "acceptance_refs":{"type":"array","items":{"type":"string","minLength":1}},
        "terminal_refs":{"type":"array","items":{"type":"string","minLength":1}},
        "invalidation_triggers":{"type":"array","items":{"type":"string","minLength":1}}
      }
    },
    "step":{
      "type":"object","additionalProperties":false,
      "required":["id","title","outcome_supported","owner_ref","depends_on","gate_refs","execution_class","expected_effect_surface","acceptance_conditions","stop_conditions"],
      "properties":{
        "id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},
        "outcome_supported":{"type":"array","items":{"type":"string","minLength":1}},
        "owner_ref":{"type":"string","minLength":1},
        "depends_on":{"type":"array","items":{"type":"string","minLength":1}},
        "gate_refs":{"type":"array","items":{"type":"string","minLength":1}},
        "execution_class":{"type":"string","minLength":1},
        "expected_effect_surface":{"type":"array","items":{"type":"string","minLength":1}},
        "acceptance_conditions":{"type":"array","items":{"type":"string","minLength":1}},
        "stop_conditions":{"type":"array","items":{"type":"string","minLength":1}}
      }
    },
    "impact":{
      "type":"object","additionalProperties":false,
      "required":["object_id","object_type","owner_ref","source_ref","impact_type"],
      "properties":{
        "object_id":{"type":"string","minLength":1},"object_type":{"type":"string","minLength":1},
        "owner_ref":{"type":"string","minLength":1},"source_ref":{"type":"string","minLength":1},
        "impact_type":{"type":"string","minLength":1}
      }
    },
    "association":{
      "type":"object","additionalProperties":false,
      "required":["source","target","relation","basis_ref","currentness"],
      "properties":{
        "source":{"type":"string","minLength":1},"target":{"type":"string","minLength":1},
        "relation":{"enum":["DEPENDS_ON","REQUIRES_CAPABILITY","REQUIRES_PATH","AFFECTS","BLOCKS","SATISFIES","OWNED_BY","PROVEN_BY","INVALIDATED_BY"]},
        "basis_ref":{"type":"string","minLength":1},"currentness":{"type":"string","minLength":1}
      }
    },
    "gate":{
      "type":"object","additionalProperties":false,
      "required":["id","type","condition","pass_condition","fail_disposition","owner_ref"],
      "properties":{
        "id":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},
        "condition":{"type":"string","minLength":1},"pass_condition":{"type":"string","minLength":1},
        "fail_disposition":{"type":"string","minLength":1},"owner_ref":{"type":"string","minLength":1}
      }
    },
    "falsifier":{
      "type":"object","additionalProperties":false,
      "required":["id","condition","consequence"],
      "properties":{"id":{"type":"string","minLength":1},"condition":{"type":"string","minLength":1},"consequence":{"type":"string","minLength":1}}
    }
  }
}